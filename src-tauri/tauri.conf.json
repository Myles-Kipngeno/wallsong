{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallsong",
  "version": "0.1.0",
  "identifier": "app.wallsong.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "wallpaper",
        "title": "Wallsong",
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
